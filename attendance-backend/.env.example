# Database connection string (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@localhost:5432/attendance_db?schema=public"

# Secret key for JWT signing (replace with a long, secure random string)
JWT_SECRET="replace-with-a-secure-random-secret"

# Port for the backend API and WebSocket server
PORT=10000

# Allowed frontend origins for CORS (comma-separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
